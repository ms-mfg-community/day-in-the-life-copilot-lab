.github/workflows/*.lock.yml linguist-generated=true

# Lab 12 ships a small Apache Parquet fixture (labs/fixtures/lab12/sales.parquet).
# Mark all .parquet files as binary so Git never applies line-ending or text
# normalization that would corrupt the file's footer/magic bytes (PAR1 ... PAR1).
*.parquet binary

# Prepared runtime scripts execute in Linux even when the maintainer uses Windows.
packaging/core/**/*.sh text eol=lf
packaging/core/lab-core text eol=lf
packaging/core/copilot text eol=lf

# Copilot hook scripts are executed by bash. A CRLF in the shebang line makes
# the interpreter "bad interpreter: /usr/bin/env bash^M" and the hook fails —
# which for preToolUse fails closed and locks the CLI. Pinning eol=lf also stops
# core.autocrlf=true from reporting all nine of these as permanently modified.
scripts/hooks/**/*.sh text eol=lf

# Lab fixture scripts are run by learners, on Windows as often as on Linux, and
# a CRLF in the shebang gives "/usr/bin/env: 'bash\r': No such file or
# directory" under WSL or Git Bash. Same failure mode as the hook scripts above,
# same fix. Lab 23 ships the first of these.
labs/fixtures/**/*.sh text eol=lf