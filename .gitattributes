.github/workflows/*.lock.yml linguist-generated=true

# Lab 12 ships a small Apache Parquet fixture (labs/fixtures/lab12/sales.parquet).
# Mark all .parquet files as binary so Git never applies line-ending or text
# normalization that would corrupt the file's footer/magic bytes (PAR1 ... PAR1).
*.parquet binary

# Prepared runtime scripts execute in Linux even when the maintainer uses Windows.
packaging/core/**/*.sh text eol=lf
packaging/core/lab-core text eol=lf
packaging/core/copilot text eol=lf

# Every other executable script has the same requirement, and the narrow rule
# above left them exposed: with core.autocrlf=true a Windows checkout gives them
# CRLF, and bash then fails on the first line it reads --
#   scripts/preflight.sh: line 22: $'\r': command not found
# That breaks the repo for any learner on Git Bash, or on WSL2 with the clone
# under /mnt/c/, and preflight.sh is the first script a learner runs.
*.sh text eol=lf
.githooks/* text eol=lf
solutions/lab-gh-extensions/gh-clab/gh-clab text eol=lf
scripts/workshop/*.mjs text eol=lf
scripts/generate-lab12-fixture.py text eol=lf
workshop/site/hackathon.html -text
