{
  "name": "day-in-the-life-copilot-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Lab harness for Day-in-the-Life Copilot Lab. Hosts Vitest suites that gate doc + content changes.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:lab-structure": "vitest run tests/lab-structure",
    "test:content-currency": "vitest run tests/content-currency",
    "test:packaging": "vitest run tests/packaging",
    "test:packaging:coverage": "vitest run tests/packaging --coverage",
    "build:slides": "node scripts/workshop/build-slides.mjs",
    "spa:dev": "vite --config workshop/spa/vite.config.ts",
    "spa:build": "vite build --config workshop/spa/vite.config.ts",
    "spa:validate": "node scripts/spa/validate.mjs",
    "spa:test:present": "npm run spa:build && vitest run tests/spa/presentation-mode.test.ts && node --test tests/spa/presentation-browser-check.mjs",
    "spa:test:sync": "npm run spa:build && vitest run tests/spa/sync-core.test.ts tests/spa/sync-content.test.ts tests/spa/sync-speaker.test.ts tests/spa/sync-shell.test.ts && node --test tests/spa/sync-browser-check.mjs",
    "spa:frontmatter-keys": "node scripts/spa/frontmatter-keys.mjs"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.17.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "prettier": "^3.9.6",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "reveal.js": "^6.0.1",
    "shiki": "^4.0.2",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
