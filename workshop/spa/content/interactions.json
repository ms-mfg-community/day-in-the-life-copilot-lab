      "keys": ["Tab", "ArrowLeft", "ArrowRight", "Home", "End"],
      "statusRegion": false
    },
    {
      "id": "m1-extensibility-map",
      "pattern": "node-diagram",
      "segment": "m1-extensibility-architecture",
